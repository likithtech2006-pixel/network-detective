# ==============================================================================
# Network Detective & Self-Healing Network - Environment Configuration Template
# Copy this file to .env and adjust variables as needed for your environment.
# ==============================================================================

# Application Settings
APP_NAME="Network Detective & Self-Healing Network"
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
POLLING_INTERVAL=5
LOG_LEVEL=INFO

# Database Settings
# Default: async SQLite
DATABASE_URL=sqlite+aiosqlite:///./network_detective.db
# PostgreSQL (Alternative):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/network_detective

# Monitoring & Detection Thresholds
LATENCY_WARN_MS=100
LATENCY_CRITICAL_MS=200
PACKET_LOSS_WARN_PCT=5.0
PACKET_LOSS_CRITICAL_PCT=10.0
PING_TIMEOUT_SEC=3.0
MAX_RETRIES=3

# SMTP Alert Settings (Optional)
SMTP_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=alerts@example.com
SMTP_PASSWORD=secret_password
SMTP_FROM=network-detective@example.com
SMTP_TO=noc-alerts@example.com
SMTP_USE_TLS=true
